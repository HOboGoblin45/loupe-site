# Partner report access tokens. The token IS the password for a partner's
# private report URL, so it stays on this machine. Losing this file just means
# the next build mints new tokens and you re-send the links.
tools/data/keys.json

# Loupe Index brand-card tokens, and the outreach list built from them. These
# are stronger than the partner tokens: the card files in /index/d/ are AES-GCM
# ciphertext keyed on the token, so this file is the ONLY way to read any of
# them. That is deliberate — loupe-site is a public repository, so an
# unguessable filename protects nothing on its own. Losing this file makes 139
# cards permanently unreadable by anyone including us; rebuilding mints new
# tokens and new links.
tools/data/index_keys.json
tools/data/index_links.txt

# Index outreach working files. index_drafts.json and index_outreach.json carry
# brand contact emails AND live card tokens; a token in a public repo is the
# card, so these never get committed. Regenerate with build_index_outreach.py.
tools/data/index_outreach.json
tools/data/index_drafts.json

# build_brand_briefs.py imports build_loupe_index.py as a module, which makes
# CPython leave bytecode behind next to the tools.
tools/__pycache__/

# Per-brand positioning briefs (build_brand_briefs.py). STAGED, NOT LIVE, and
# not a route on the site — each page carries one label's own numbers under its
# own name and is meant to be sent to that label, not published. This repo is
# PUBLIC, so committing them would put every brief in front of every brand's
# competitors; if they are ever served from useloupe.shop they need the same
# AES-GCM-under-the-token treatment /index/d/ already has. The directory name
# says "staging" so nobody has to read this comment to know.
briefs-staging/
